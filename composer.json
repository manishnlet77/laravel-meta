{
    "name": "manishnlet77/laravel-meta",
    "description": "A modular Meta API SDK/integration package for Laravel, with optional persistence and optional automation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "meta",
        "facebook",
        "api",
        "sdk"
    ],
    "authors": [
        {
            "name": "Manish Saini",
            "email": "ms44587@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/manishnlet77/laravel-meta"
    },
    "require": {
        "php": "^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\LaravelMeta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\LaravelMeta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\LaravelMeta\\MetaServiceProvider"
            ],
            "aliases": {
                "Meta": "Vendor\\LaravelMeta\\Facades\\Meta"
            }
        }
    },
    "minimum-stability": "stable"
}
